{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  nix: {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    platformAutomerge: true,
    schedule: ['at any time'],
    commitMessageAction: 'nix flake update',
  },
  packageRules: [
    {
      matchManagers: ['custom.regex'],
      automerge: true,
      platformAutomerge: true,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.nix$/',
      ],
      matchStrings: [
        'image = "(?<depName>[^:"]+):(?<currentValue>[^@"]+)@(?<currentDigest>sha256:[a-f0-9]+)"',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  semanticCommitScope: '',
  schedule: [
    'at any time',
  ],
}
