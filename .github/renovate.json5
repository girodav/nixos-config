{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "platformAutomerge": true,
    "commitMessageAction": "nix flake update",
    "commitMessageTopic": null,
    "commitMessageExtra": null
  },
  "semanticCommitScope": "",
  "schedule": ["at any time"]
}